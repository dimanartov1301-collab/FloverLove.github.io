<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FloverLove — цветы и подарки с доставкой</title>
<style>
  :root{
    --bg:#fffaf5; --panel:#ffffff; --line:#f0e2d8;
    --text:#3d2b22; --muted:#9b8478;
    --accent:#e5677c; --accent-dark:#c94b60; --accent-soft:#fdeef1;
    --green:#5dd97c; --shadow:0 8px 24px rgba(180,120,100,.12);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{background:var(--bg); color:var(--text); font-family:'Segoe UI',Arial,sans-serif;}
  a{color:inherit; text-decoration:none;}

  /* шапка */
  header{position:sticky; top:0; z-index:10; background:var(--panel);
    border-bottom:1px solid var(--line); box-shadow:0 2px 12px rgba(180,120,100,.08);}
  .hwrap{max-width:1200px; margin:0 auto; padding:12px 16px;
    display:flex; align-items:center; gap:16px;}
  .logo{font-size:22px; font-weight:800; white-space:nowrap;}
  .logo span{color:var(--accent);}
  .search{flex:1; display:flex;}
  .search input{flex:1; border:1px solid var(--line); border-right:none; padding:10px 14px;
    border-radius:10px 0 0 10px; font-size:14px; outline:none; background:var(--bg);}
  .search button{background:var(--accent); color:#fff; border:none; padding:0 18px;
    border-radius:0 10px 10px 0; cursor:pointer; font-size:16px;}
  .cart-btn{position:relative; background:var(--accent-soft); border:1px solid var(--line);
    border-radius:10px; padding:10px 16px; cursor:pointer; font-size:16px;}
  .cart-btn b{position:absolute; top:-6px; right:-6px; background:var(--accent); color:#fff;
    font-size:11px; min-width:18px; height:18px; border-radius:9px;
    display:flex; align-items:center; justify-content:center; padding:0 4px;}

  /* категории */
  .cats{max-width:1200px; margin:0 auto; padding:12px 16px 0; display:flex; gap:8px;
    overflow-x:auto; scrollbar-width:none;}
  .cats::-webkit-scrollbar{display:none;}
  .cat{white-space:nowrap; border:1px solid var(--line); background:var(--panel);
    padding:8px 16px; border-radius:20px; cursor:pointer; font-size:14px; color:var(--muted); transition:.2s;}
  .cat.active{background:var(--accent); border-color:var(--accent); color:#fff; font-weight:600;}

  /* каталог */
  main{max-width:1200px; margin:0 auto; padding:20px 16px 60px;}
  h2{margin-bottom:16px; font-size:22px;}
  .grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:16px;}
  .card{background:var(--panel); border:1px solid var(--line); border-radius:16px;
    overflow:hidden; display:flex; flex-direction:column; transition:.2s; box-shadow:var(--shadow);}
  .card:hover{transform:translateY(-4px);}
  .card-img{height:160px; display:flex; align-items:center; justify-content:center;
    font-size:64px; background:linear-gradient(135deg,var(--accent-soft),#fff6ef);}
  .card-body{padding:14px; display:flex; flex-direction:column; gap:8px; flex:1;}
  .card-name{font-weight:700; font-size:15px;}
  .card-meta{color:var(--muted); font-size:12px;}
  .card-foot{margin-top:auto; display:flex; align-items:center; justify-content:space-between; gap:8px;}
  .price{font-weight:800; font-size:17px;}
  .old{color:var(--muted); text-decoration:line-through; font-size:12px; font-weight:400; margin-left:4px;}
  .add{background:var(--accent); color:#fff; border:none; border-radius:10px;
    padding:8px 14px; cursor:pointer; font-weight:700; transition:.15s;}
  .add:hover{background:var(--accent-dark);}
  .badge{align-self:flex-start; font-size:11px; font-weight:700; padding:3px 10px;
    border-radius:20px; margin-bottom:4px;}
  .badge.hit{background:#ffe9e0; color:#c2542e;}
  .badge.new{background:#e3f4e8; color:#2e7d43;}
  .badge.choice{background:#efe3ff; color:#7a3fc0;}

  /* промо */
  .promo{margin:30px 0 0; background:linear-gradient(120deg,var(--accent-soft),#fff3e8);
    border:1px solid var(--line); border-radius:16px; padding:24px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;}
  .promo b{font-size:20px;}
  .promo-code{background:#fff; border:2px dashed var(--accent); padding:10px 18px;
    border-radius:10px; font-weight:800; letter-spacing:2px;}

  /* корзина */
  .overlay{position:fixed; inset:0; background:rgba(61,43,34,.45); display:none; z-index:20;}
  .overlay.open{display:block;}
  .cart{position:fixed; top:0; right:-420px; width:min(420px,100vw); height:100vh;
    background:var(--panel); z-index:21; transition:right .25s; display:flex; flex-direction:column;
    box-shadow:-8px 0 30px rgba(61,43,34,.15);}
  .cart.open{right:0;}
  .cart-head{display:flex; align-items:center; justify-content:space-between;
    padding:16px; border-bottom:1px solid var(--line);}
  .cart-head h3{font-size:18px;}
  .close{background:none; border:none; font-size:22px; cursor:pointer; color:var(--muted);}
  .cart-items{flex:1; overflow-y:auto; padding:16px;}
  .ci{display:flex; justify-content:space-between; align-items:center; gap:10px;
    padding:10px 0; border-bottom:1px dashed var(--line);}
  .ci .qty{display:flex; align-items:center; gap:8px;}
  .qty button{width:26px; height:26px; border-radius:8px; border:1px solid var(--line);
    background:var(--bg); cursor:pointer; font-weight:700;}
  .cart-foot{padding:16px; border-top:1px solid var(--line);}
  .total{display:flex; justify-content:space-between; font-weight:800; font-size:18px; margin-bottom:12px;}
  .empty{color:var(--muted); text-align:center; padding:40px 0;}

  /* модалка заказа */
  .modal{position:fixed; inset:0; background:rgba(61,43,34,.5); display:none;
    align-items:center; justify-content:center; z-index:30; padding:16px;}
  .modal.open{display:flex;}
  .modal-box{background:var(--panel); border-radius:16px; padding:24px; width:min(480px,100%);
    max-height:90vh; overflow-y:auto;}
  .modal-box h3{margin-bottom:14px;}
  .field{margin-bottom:12px;}
  .field label{display:block; font-size:13px; color:var(--muted); margin-bottom:4px;}
  .field input,.field select,.field textarea{width:100%; border:1px solid var(--line);
    border-radius:10px; padding:10px 12px; font-size:14px; font-family:inherit;
    background:var(--bg); outline:none;}
  .btn-primary{width:100%; background:var(--accent); color:#fff; border:none; padding:12px;
    border-radius:10px; font-weight:800; font-size:16px; cursor:pointer; margin-top:6px;}
  .btn-primary:hover{background:var(--accent-dark);}
  .ok{text-align:center; padding:30px 10px;}
  .ok .big{font-size:48px;}
  .ok b{color:var(--accent);}

  /* шаги */
  .steps{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-top:16px;}
  .step{background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:20px;}
  .step .n{width:34px; height:34px; border-radius:50%; background:var(--accent-soft);
    color:var(--accent); font-weight:800; display:flex; align-items:center; justify-content:center; margin-bottom:10px;}
  .step p{color:var(--muted); font-size:13px; margin-top:4px;}

  /* футер */
  footer{background:#3d2b22; color:#f3e6dd; padding:36px 16px; margin-top:40px;}
  .fwrap{max-width:1200px; margin:0 auto; display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:24px;}
  footer h4{margin-bottom:10px; font-size:15px;}
  footer li{list-style:none; margin-bottom:6px; font-size:14px; color:#cbb5a6;}
  .copy{max-width:1200px; margin:24px auto 0; padding-top:16px;
    border-top:1px solid rgba(255,255,255,.15); font-size:12px; color:#a8907f;}

  .toast{position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(80px);
    background:var(--text); color:#fff; padding:10px 20px; border-radius:10px;
    font-size:14px; transition:.3s; z-index:40; opacity:0;}
  .toast.show{transform:translateX(-50%); opacity:1;}

  @media(max-width:640px){
    .hwrap{flex-wrap:wrap;}
    .search{order:3; width:100%;}
  }
</style>
</head>
<body>

<header>
  <div class="hwrap">
    <div class="logo">🌸 Flover<span>Love</span></div>
    <div class="search">
      <input id="search" placeholder="Поиск: розы, пионы, торт…">
      <button onclick="renderCatalog()">🔍</button>
    </div>
    <button class="cart-btn" onclick="openCart()">🛒<b id="cartCount">0</b></button>
  </div>
</header>

<nav class="cats" id="cats"></nav>

<main>
  <h2 id="catTitle">Все букеты и подарки</h2>
  <div class="grid" id="grid"></div>

  <div class="promo">
    <div><b>Цветы с доставкой за 2 часа 🚀</b><br>
      <span style="color:var(--muted)">При заказе от 3000 ₽ доставка бесплатно</span></div>
    <div class="promo-code">FLOWER10 — скидка 10%</div>
  </div>

  <h2 style="margin-top:40px">Как это работает</h2>
  <div class="steps">
    <div class="step"><div class="n">1</div><b>Выбери букет</b><p>В каталоге — свежие цветы и подарки от проверенных флористов.</p></div>
    <div class="step"><div class="n">2</div><b>Укажи адрес</b><p>Доставим в удобное время, курьер свяжется перед вручением.</p></div>
    <div class="step"><div class="n">3</div><b>Добавь открытку</b><p>Напишем твоё пожелание от руки — бесплатно.</p></div>
    <div class="step"><div class="n">4</div><b>Получи фото вручения</b><p>Пришлём снимок счастливого момента в мессенджер.</p></div>
  </div>
</main>

<!-- корзина -->
<div class="overlay" id="overlay" onclick="closeCart()"></div>
<aside class="cart" id="cart">
  <div class="cart-head"><h3>🛒 Корзина</h3><button class="close" onclick="closeCart()">✕</button></div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-foot">
    <div class="total"><span>Итого</span><span id="cartTotal">0 ₽</span></div>
    <button class="btn-primary" onclick="checkout()">Оформить заказ</button>
  </div>
</aside>

<!-- оформление -->
<div class="modal" id="modal">
  <div class="modal-box" id="modalContent"></div>
</div>

<footer>
  <div class="fwrap">
    <div>
      <h4>🌸 FloverLove</h4>
      <li>Цветы и подарки с доставкой<br>по городу от 2 часов.</li>
    </div>
    <div><h4>Покупателям</h4>
      <li>Каталог · Оплата · Доставка<br>Возврат · FAQ</li></div>
    <div><h4>Контакты</h4>
      <li>+7 (900) 000-00-00<br>hello@floverlove.demo</li></div>
  </div>
  <div class="copy">© 2026 FloverLove. Демо-сайт: заказы и оплаты не производятся, контакты — заглушки.</div>
</footer>

<div class="toast" id="toast"></div>

<script>
'use strict';

// ---------- каталог ----------
const PRODUCTS = [
  {id:1, cat:'bouquets', icon:'🌹', name:'Букет «Красная страсть»', desc:'25 красных роз',    price:3490, old:4200, badge:'hit'},
  {id:2, cat:'peonies',  icon:'🌺', name:'Пионы «Розовое облако»',  desc:'15 пионов в крафте',  price:2890, old:0,    badge:'new'},
  {id:3, cat:'bouquets', icon:'💐', name:'Букет «Весенняя нежность»',desc:'тюльпаны и эустома', price:2190, old:0,    badge:''},
  {id:4, cat:'roses',    icon:'🥀', name:'Розы «Белый вальс»',      desc:'51 белая роза',       price:5990, old:6900, badge:'choice'},
  {id:5, cat:'gifts',    icon:'🍰', name:'Торт «Малиновый бархат»', desc:'1,5 кг, ручная работа',price:2900, old:0,   badge:'hit'},
  {id:6, cat:'boxes',    icon:'🎁', name:'Бокс «Цветы в шляпке»',   desc:'гортензия и розы',    price:4100, old:0,    badge:''},
  {id:7, cat:'sweets',   icon:'🍫', name:'Набор «Сладкий вечер»',   desc:'макаруны и шоколад',  price:1750, old:2100, badge:''},
  {id:8, cat:'balloons', icon:'🎈', name:'Композиция «Праздник»',   desc:'15 шаров с гелием',   price:2300, old:0,    badge:'new'},
  {id:9, cat:'roses',    icon:'🌷', name:'Тюльпаны «100 штук»',     desc:'микс оттенков',       price:5400, old:0,    badge:''},
  {id:10,cat:'peonies',  icon:'🌸', name:'Пионы «Сара Бернар»',     desc:'25 розовых пионов',   price:4500, old:5200, badge:'choice'},
  {id:11,cat:'boxes',    icon:'🧺', name:'Бокс «Пикник»',           desc:'цветы, ягоды, макаруны',price:5600, old:0,   badge:'hit'},
  {id:12,cat:'gifts',    icon:'🧸', name:'Мишка + розы',            desc:'букет с мягкой игрушкой',price:3200, old:0,  badge:''},
];

const CATS = [
  {id:'all',      name:'Всё сразу'},
  {id:'bouquets', name:'Букеты'},
  {id:'roses',    name:'Розы'},
  {id:'peonies',  name:'Пионы'},
  {id:'boxes',    name:'Цветочные боксы'},
  {id:'gifts',    name:'Подарки'},
  {id:'sweets',   name:'Сладости'},
  {id:'balloons', name:'Шары'},
];
const BADGES = {hit:['Хит','hit'], new:['Новинка','new'], choice:['Выбор покупателей','choice']};

let activeCat = 'all';
let cart = []; // {id, qty}

const $ = id => document.getElementById(id);
const fmt = n => n.toLocaleString('ru-RU') + ' ₽';

// ---------- рендер ----------
function renderCats(){
  $('cats').innerHTML = '';
  CATS.forEach(c=>{
    const b = document.createElement('div');
    b.className = 'cat' + (c.id===activeCat?' active':'');
    b.textContent = c.name;
    b.onclick = ()=>{ activeCat=c.id; $('catTitle').textContent = c.id==='all'?'Все букеты и подарки':c.name; renderCats(); renderCatalog(); };
    $('cats').appendChild(b);
  });
}

function renderCatalog(){
  const q = $('search').value.trim().toLowerCase();
  const list = PRODUCTS.filter(p =>
    (activeCat==='all' || p.cat===activeCat) &&
    (!q || p.name.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q))
  );
  $('grid').innerHTML = '';
  if(!list.length){ $('grid').innerHTML = '<div class="empty" style="grid-column:1/-1">Ничего не нашлось 🤷 Попробуй «розы» или «торт».</div>'; return; }
  list.forEach(p=>{
    const card = document.createElement('div');
    card.className = 'card';
    const badge = p.badge ? `<span class="badge ${BADGES[p.badge][1]}">${BADGES[p.badge][0]}</span>` : '';
    const old = p.old ? `<span class="old">${fmt(p.old)}</span>` : '';
    card.innerHTML = `
      <div class="card-img">${p.icon}</div>
      <div class="card-body">
        ${badge}
        <div class="card-name">${p.name}</div>
        <div class="card-meta">${p.desc}</div>
        <div class="card-foot">
          <div class="price">${fmt(p.price)}${old}</div>
          <button class="add" onclick="addToCart(${p.id})">В корзину</button>
        </div>
      </div>`;
    $('grid').appendChild(card);
  });
}

// ---------- корзина ----------
function addToCart(id){
  const row = cart.find(r=>r.id===id);
  row ? row.qty++ : cart.push({id, qty:1});
  renderCart(); toast('Добавлено в корзину 🌷');
}
function changeQty(id, d){
  const row = cart.find(r=>r.id===id);
  if(!row) return;
  row.qty += d;
  if(row.qty<=0) cart = cart.filter(r=>r.id!==id);
  renderCart();
}
function cartSum(){ return cart.reduce((s,r)=> s + PRODUCTS.find(p=>p.id===r.id).price*r.qty, 0); }

function renderCart(){
  $('cartCount').textContent = cart.reduce((s,r)=>s+r.qty,0);
  if(!cart.length){
    $('cartItems').innerHTML = '<div class="empty">Корзина пуста — самое время выбрать букет 💐</div>';
  } else {
    $('cartItems').innerHTML = cart.map(r=>{
      const p = PRODUCTS.find(x=>x.id===r.id);
      return `<div class="ci">
        <div>${p.icon} <b>${p.name}</b><br><small style="color:var(--muted)">${fmt(p.price)}</small></div>
        <div class="qty">
          <button onclick="changeQty(${p.id},-1)">−</button>${r.qty}
          <button onclick="changeQty(${p.id},1)">+</button>
          <b style="min-width:70px;text-align:right">${fmt(p.price*r.qty)}</b>
        </div></div>`;
    }).join('');
  }
  const sum = cartSum();
  $('cartTotal').textContent = fmt(sum >= 3000 ? sum : sum + 300); // доставка 300 ₽, от 3000 ₽ бесплатно
}

function openCart(){ $('cart').classList.add('open'); $('overlay').classList.add('open'); renderCart(); }
function closeCart(){ $('cart').classList.remove('open'); $('overlay').classList.remove('open'); }

// ---------- оформление ----------
function checkout(){
  if(!cart.length){ toast('Сначала добавь цветы в корзину 🌷'); return; }
  closeCart();
  $('modal').classList.add('open');
  $('modalContent').innerHTML = `
    <h3>Оформление заказа</h3>
    <div class="field"><label>Имя получателя</label><input id="fName" placeholder="Анна"></div>
    <div class="field"><label>Адрес доставки</label><input id="fAddr" placeholder="ул. Цветочная, 7, кв. 12"></div>
    <div class="field"><label>Телефон</label><input id="fPhone" placeholder="+7 (___) ___-__-__"></div>
    <div class="field"><label>Время доставки</label>
      <select id="fTime"><option>Как можно быстрее (от 2 часов)</option><option>Сегодня к вечеру</option><option>Завтра утром (9:00–12:00)</option><option>Укажу в комментарии</option></select></div>
    <div class="field"><label>Текст открытки (необязательно)</label><textarea id="fNote" rows="3" placeholder="С днём рождения!"></textarea></div>
    <div class="total"><span>К оплате</span><span>${$('cartTotal').textContent}</span></div>
    <button class="btn-primary" onclick="placeOrder()">Подтвердить заказ</button>`;
}

function placeOrder(){
  cart = []; renderCart();
  $('modalContent').innerHTML = `
    <div class="ok">
      <div class="big">💐</div>
      <h3 style="margin:10px 0">Заказ принят!</h3>
      <p style="color:var(--muted)">Флорист уже собирает букет. Курьер свяжется с получателем перед вручением.</p>
      <button class="btn-primary" onclick="closeModal()">Отлично!</button>
    </div>`;
}
function closeModal(){ $('modal').classList.remove('open'); }

// ---------- мелочи ----------
let toastTimer;
function toast(msg){
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(()=>t.classList.remove('show'), 2000);
}
$('search').addEventListener('keydown', e=>{ if(e.key==='Enter') renderCatalog(); });

renderCats(); renderCatalog(); renderCart();
</script>
</body>
</html>
